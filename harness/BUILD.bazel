load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "harness",
    srcs = [
        "__init__.py",
        "a2a_client.py",
        "a2a_view.py",
        "adk_client.py",
        "compare.py",
        "lint.py",
        "normalize.py",
        "paths.py",
        "proxy.py",
        "runner.py",
        "subjects.py",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//model_server:server",
        "@pip//pyyaml",
    ],
)

# Entry points used by the generated tests (tools/bazel/conformance.bzl).
exports_files([
    "lint.py",
    "run_scenario.py",
])

# Differential oracle and report:
#   bazel run //harness:compare -- --in "$PWD/bazel-testlogs" --out /tmp/report
py_binary(
    name = "compare",
    srcs = ["compare.py"],
    visibility = ["//visibility:public"],
    deps = [":harness"],
)

py_test(
    name = "paths_test",
    size = "small",
    srcs = ["paths_test.py"],
    deps = [":harness"],
)

py_test(
    name = "adk_client_test",
    size = "small",
    srcs = ["adk_client_test.py"],
    deps = [":harness"],
)

py_test(
    name = "runner_test",
    size = "small",
    srcs = ["runner_test.py"],
    deps = [":harness"],
)

py_test(
    name = "compare_test",
    size = "small",
    srcs = ["compare_test.py"],
    deps = [":harness"],
)

py_test(
    name = "a2a_view_test",
    size = "small",
    srcs = ["a2a_view_test.py"],
    deps = [":harness"],
)

# harness/subjects.py, tools/bazel/subjects.bzl and .bazelignore agree on the
# paused subjects.
py_test(
    name = "subjects_test",
    size = "small",
    srcs = ["subjects_test.py"],
    args = [
        "$(rootpath //tools/bazel:subjects.bzl)",
        "$(rootpath //:.bazelignore)",
    ],
    data = [
        "//:.bazelignore",
        "//tools/bazel:subjects.bzl",
    ],
    deps = [":harness"],
)
